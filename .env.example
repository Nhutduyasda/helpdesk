# Real-data mode is the default. Copy to .env.local; never commit actual values.
VITE_SUPABASE_URL=https://YOUR_TEST_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_TEST_PROJECT_KEY
# Demo is honored only by Vite development builds, never production/staging builds.
VITE_ITCARE_DEMO=false
