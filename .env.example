# Real-data mode is the default. Copy to .env.local; never commit actual values.
VITE_SUPABASE_URL=https://YOUR_TEST_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_TEST_PROJECT_KEY
# Demo is honored only by Vite development builds, never production/staging builds.
VITE_ITCARE_DEMO=false

# Optional live QA only; keep real values in ignored .env.local.
# These MUST NOT have the VITE_ prefix or be supplied to a hosting build.
ITCARE_TEST_IT_EMAIL=
ITCARE_TEST_IT_PASSWORD=
ITCARE_TEST_A_EMAIL=
ITCARE_TEST_A_PASSWORD=
ITCARE_TEST_B_EMAIL=
ITCARE_TEST_B_PASSWORD=

# Public intake: use the office-approved department labels separated by |.
VITE_ITCARE_DEPARTMENTS=
VITE_TURNSTILE_SITE_KEY=
# Edge Function secrets (configure in Supabase, never VITE-prefixed):
# INTAKE_DEPARTMENTS= same approved list
# INTAKE_ORIGINS= exact permitted origin(s), separated by |
# TURNSTILE_SECRET_KEY=
# INTAKE_RATE_SECRET= random secret for HMAC IP buckets
# INTAKE_TRUSTED_IP_HEADER= leave unset until gateway overwrite is verified
